# Salin ke .env lalu isi — JANGAN commit file .env
# Broker MQTT (Mosquitto). Server connect dari localhost/VPS; device dari internet.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# User MQTT untuk server dashboard
MQTT_USER=lele-server
MQTT_PASS=ISI_PASSWORD_MQTT_SERVER
# User MQTT untuk device ESP32 (dipakai firmware + simulator)
ESP_MQTT_USER=lele-esp32-01
ESP_MQTT_PASS=ISI_PASSWORD_MQTT_DEVICE
# Port HTTP server dashboard
PORT=3102
